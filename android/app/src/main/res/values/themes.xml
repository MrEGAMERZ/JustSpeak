<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JustSpeak" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/keyboard_accent</item>
        <item name="colorOnPrimary">@color/keyboard_bg</item>
        <item name="android:statusBarColor">@color/onboarding_bg</item>
        <item name="android:navigationBarColor">@color/onboarding_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.JustSpeak.KeyboardButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/keyboard_accent</item>
        <item name="android:textColor">@color/keyboard_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.JustSpeak.KeyboardButton.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/keyboard_surface_alt</item>
        <item name="android:textColor">@color/keyboard_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
